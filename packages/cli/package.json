{
  "name": "transcripts-mcp",
  "version": "0.0.3",
  "private": false,
  "description": "Search local Cursor, Claude Code, and Codex session transcripts via MCP",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stormix/transcripts-mcp.git"
  },
  "bin": {
    "transcripts-mcp": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/server.js",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun ../../scripts/build-cli.ts --bundle-only",
    "smoke:artifact": "node dist/smoke-artifact.js",
    "check-types": "tsc --noEmit --skipLibCheck",
    "test": "vitest run --config ../../vitest.config.mts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@transcripts-mcp/contracts": "workspace:*",
    "@transcripts-mcp/typescript-config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
