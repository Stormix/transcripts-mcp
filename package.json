{
  "name": "@transcripts-mcp/workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*",
    "distribution/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "vitest run",
    "bench": "bun packages/search/src/bench/compare.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "upgrade:deps": "pnpm dlx taze major -r -w",
    "changeset": "changeset",
    "start": "pnpm --filter @transcripts-mcp/mcp start",
    "deploy:www": "pnpm --filter @transcripts-mcp/www run deploy",
    "build:cli": "bun scripts/build-cli.ts",
    "sync:plugin-version": "bun scripts/sync-plugin-version.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@transcripts-mcp/oxlint-plugins": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "^2.10.9",
    "typescript": "catalog:",
    "vitest": "^5.0.0",
    "zod": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.21.0"
}
